PORT=8080
HOST=localhost

# "true" for local dev so backends resolve to localhost:<port>;
# leave unset/"false" in Kubernetes so KubeResolver uses cluster DNS.
RIDEGO_LOCAL_DEV=true

REDIS_ADDR=localhost:6379

# RSA public key matching the User service's private key.
# Store the PEM with literal "\n" in place of newlines.
JWT_PUBLIC_KEY=
